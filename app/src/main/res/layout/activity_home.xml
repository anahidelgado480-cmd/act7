<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <ImageView
        android:id="@+id/imgfonfondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondonino"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAMES"
            android:textSize="80dp"
            android:textStyle="bold"
            android:textColor="#000000"/>



        <Button
            android:id="@+id/btncel"
            android:layout_width="300dp"
            android:layout_height="100dp"
            android:text="NUMBERS"
            android:layout_marginTop="20dp"
            android:textSize="30dp"
            android:backgroundTint="#F2C8DD"
            />
        <ImageButton
            android:id="@+id/btncelo"
            android:layout_width="300dp"
            android:layout_height="100dp"
            android:text="NUMBERS"

            android:layout_marginTop="20dp"
            android:textSize="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/boton1"/>

        <Button
            android:id="@+id/btnFare"
            android:layout_width="300dp"
            android:layout_height="100dp"
            android:text="ANIMALS"
            android:layout_marginTop="30dp"
            android:textSize="30dp"
            android:backgroundTint="#D3DB7F"/>

        <Button
            android:id="@+id/btnIMC"
            android:layout_width="300dp"
            android:layout_height="100dp"
            android:text="COLORS"
            android:layout_marginTop="30dp"
            android:backgroundTint="#A5DBF8"
            android:textSize="30dp" />







    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>