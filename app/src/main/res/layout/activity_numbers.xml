<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A4E8F8"
    tools:context=".Numbers">


    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondonino" />


    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="#FCE4D6"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUMBERS"
            android:textColor="#F36C21"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡PRESIONA EL NUMERO Y ESCUCHALO!"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>



    <Button
        android:id="@+id/btnNum1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/layoutHeader"
        android:layout_marginStart="35dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="#AB83D6"
        android:text="1\nONE"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/layoutHeader"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="61dp"
        android:layout_marginEnd="78dp"
        android:backgroundTint="#AB83D6"
        android:text="3\nTHREE"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum2"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_below="@id/btnNum1"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-55dp"
        android:layout_marginEnd="187dp"
        android:backgroundTint="#F06292"
        android:text="2\nTWO"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum4"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_below="@id/btnNum3"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-15dp"
        android:layout_marginEnd="17dp"
        android:backgroundTint="#E6CCFF"
        android:text="4\nFOUR"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum8"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnNum1"
        android:layout_marginStart="20dp"
        android:layout_marginTop="191dp"
        android:backgroundTint="#FF9AA2"
        android:text="8\nEIGHT"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum7"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnNum2"
        android:layout_marginStart="28dp"
        android:layout_marginTop="132dp"
        android:layout_toEndOf="@id/btnNum8"
        android:backgroundTint="#C7CEEA"
        android:text="7\nSEVEN"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum6"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnNum7"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@id/btnNum5"
        android:backgroundTint="#FDD835"
        android:text="6\nSIX"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum5"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/btnNum4"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#FF7043"
        android:text="5\nFIVE"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum9"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="155dp"
        android:backgroundTint="#D0F0C0"
        android:text="9\nNINE"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNum10"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="13dp"
        android:layout_marginBottom="127dp"
        android:layout_toEndOf="@id/btnNum9"
        android:backgroundTint="#F4511E"
        android:text="10\nTEN"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnCaterpillar"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="94dp"
        android:layout_marginBottom="120dp"
        android:textSize="22sp" />

    <ImageButton
        android:id="@+id/btngusano"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="94dp"
        android:layout_marginBottom="120dp"
        android:background="@android:color/transparent"
        android:src="@drawable/gusano"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        />

</RelativeLayout>